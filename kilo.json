{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "oracle-oci-cloud-mcp-server": {
      "type": "local",
      "command": ["uvx", "oracle.oci-cloud-mcp-server@latest"],
      "environment": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "oracle-oci-cloud-mcp-server_*": "ask"
  }
}
