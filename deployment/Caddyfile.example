# Caddy reverse proxy for The Master Radio
#
# Terminates TLS for the Next.js site and proxies Icecast through the same
# domain so listeners only ever need ports 80/443.
#
#   themasteradio.example  ->  this file's site block
#   Assumes: Next.js on 127.0.0.1:3000, AzuraCast stack on 127.0.0.1:8080-ish
#   per its docker-compose ports mapping.

themasteradio.duckdns.org {
	encode gzip

	# Next.js site
	reverse_proxy 127.0.0.1:3000

	# Icecast stream mounted under /stream (adjust mount name to your station)
	handle_path /stream/* {
		reverse_proxy 127.0.0.1:8000
	}
}
